node_modules/
# Anchored to the root on purpose. As a bare `lib/` this matched *any*
# directory called lib at any depth — including `ios/Vendor/vorbis/lib`,
# which is libvorbis itself. Twenty-two C files were silently left out of
# every commit, so the published package carried a Vorbis decoder with no
# decoder in it, and local builds passed because the files were on disk.
/lib/
*.log

# iOS
ios/build/
ios/Pods/
*.xcworkspace
xcuserdata/

# Android
android/build/
android/.gradle/
android/local.properties
.cxx/

.DS_Store

# Generated by the spike scripts, not committed — 200MB+
tone.wav
tone.flac
tone.m4a
tone.mp3

# SwiftPM
.build/
.swiftpm/
Package.resolved
