{
  "name": "yuzic-engine",
  "version": "0.0.0",
  "description": "Audio playback engine for yuzic \u2014 React Native, built to own crossfade, DSP and caching outright",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eftpmc/yuzic-engine.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "*.podspec",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "audio",
    "player",
    "crossfade",
    "equalizer"
  ],
  "peerDependencies": {
    "expo-modules-core": "^57.0.16",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "expo-modules-core": "^57.0.16",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ]
  }
}
